{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "extensions/**/*.ts"],
  // *.test.ts runs under `node --experimental-strip-types --test` with .ts
  // import specifiers (Node does no .js→.ts remap) — outside the tsc program
  // so the test files never emit into dist/.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
